# Copy to .env and fill in your own values. Never commit real keys.

# X / Twitter API key (Normal tier)
X_API_KEY=YOUR_API_KEY_HERE

# X / Twitter API key (Ultimate tier) - only needed for tier: "ultimate" or "hybrid"
X_ULTIMATE_API_KEY=YOUR_API_KEY_HERE

# Truth Social API key
TRUTH_API_KEY=YOUR_API_KEY_HERE

# Instagram API key
INSTAGRAM_API_KEY=YOUR_API_KEY_HERE

# News Feed API key
NEWS_API_KEY=YOUR_API_KEY_HERE

# Binance Square API key
BINANCE_API_KEY=YOUR_API_KEY_HERE

# YouTube API key (WebSocket URL is issued per-account; see README)
YOUTUBE_API_KEY=YOUR_API_KEY_HERE
YOUTUBE_WS_URL=YOUR_YOUTUBE_WS_URL_HERE
